{
  "name": "eric-kaine-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An independent fan archive for Eric Kaine (@eric2kaine). It is also not entirely what it seems.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "matter-js": "^0.20.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64",
    "@tailwindcss/vite": "^4.3.3",
    "@types/matter-js": "^0.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
